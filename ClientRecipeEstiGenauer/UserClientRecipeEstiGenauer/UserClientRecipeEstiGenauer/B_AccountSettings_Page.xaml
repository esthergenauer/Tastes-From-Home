<Page x:Class="UserClientRecipeEstiGenauer.B_AccountSettings_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserClientRecipeEstiGenauer"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="B_AccountSettings_Page">
    <Page.Background>
        <ImageBrush ImageSource="/RecipeBookPictuers/WindowhomePage/A_Homepage/DarkBackground.png" />
    </Page.Background>



    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="0.2*" />
        </Grid.RowDefinitions>


        <Image Source="/RecipeBookPictuers/WindowNEWsignIn/BigFrame.png" Grid.Row="1" Grid.RowSpan="7" Grid.Column="1" Grid.ColumnSpan="5" VerticalAlignment="Center" />

        
        
        <StackPanel   Orientation="Horizontal" Grid.Column="2"  Grid.ColumnSpan="3" Grid.Row="2" HorizontalAlignment="Center"  VerticalAlignment="Bottom" >
            <Image Source="/RecipeBookPictuers/WindowhomePage/B_AccountSettings/IconAccountSettings.png" />
            <TextBlock x:Name="AccountSettingTextBlock"  HorizontalAlignment="Left" TextWrapping="Wrap" Text="הגדרות אישיות" Foreground="#FF7A4928" TextAlignment="Center" FontSize="22"  />
        </StackPanel>





        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="5" >
            <TextBlock x:Name="UpdateNameTextBlack" Text=":עדכן שם    "  Foreground="#FF8F4B28" TextAlignment="Right"    />
            <TextBox x:Name="UpdateNameTextBox"  HorizontalAlignment="Center"  TextWrapping="Wrap" VerticalAlignment="Center" Background="#FFDED5BF" Foreground="#FF7B4A29" SelectionBrush="#FF7B4A29" BorderBrush="#FF884A29" Text= "{Binding userName}"   Width="247" PreviewMouseDown="UpdateNameTextBox_PreviewMouseDown" LostFocus="UpdateNameTextBox_LostFocus"   />

        </StackPanel>


        <StackPanel Grid.Column="2"  Grid.ColumnSpan="2" Grid.Row="4">
            <TextBlock x:Name="UpdatePassCodeBlack"  Text=":עדכן קוד    "  Foreground="#FF8F4B28" TextAlignment="Right"    />
            <TextBox x:Name="UpdatePassCodeTextBox"  HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"   Foreground="#FF7B4A29" SelectionBrush="#FF7B4A29" Background="#FFDED5BF" BorderBrush="#FF884A29" Text= "{Binding userPasscode}"  LostFocus="UpdatePassCodeTextBox_LostFocus" PreviewMouseDown="UpdatePassCodeTextBox_PreviewMouseDown"  Width="247" TextChanged="UpdatePassCodeTextBox_TextChanged" />
        </StackPanel>


        <Button x:Name="UpdateButton" Content="עדכן" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch"  Grid.Row="6" VerticalAlignment="Center" Width="380"  Click="Button_Click" Background="#FFDED5BF" Foreground="#FF884A29" BorderBrush="#FF884A29"/>

        <Image Source="/RecipeBookPictuers/WindowhomePage/B_AccountSettings/LogoRecipeBook.png" Grid.Column="4" Grid.Row="4"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.ColumnSpan="2" Margin="0,10,58,0" Grid.RowSpan="2"/>




    </Grid>

</Page>