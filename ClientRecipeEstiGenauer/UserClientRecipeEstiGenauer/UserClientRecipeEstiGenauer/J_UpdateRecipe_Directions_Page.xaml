<Page x:Class="UserClientRecipeEstiGenauer.J_UpdateRecipe_Directions_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserClientRecipeEstiGenauer"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="J_UpdateRecipe_Directions_Page">

    <Page.Background>
        <ImageBrush ImageSource="/RecipeBookPictuers/WindowhomePage/A_Homepage/DarkBackground.png" />
    </Page.Background>


    <Grid FlowDirection="RightToLeft">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />

        </Grid.RowDefinitions>


        <Image Source="/RecipeBookPictuers/WindowNEWsignIn/BigFrame.png" Grid.Row="0" Grid.RowSpan="20" Grid.Column="0" Grid.ColumnSpan="20" />
        <Image Source="/RecipeBookPictuers/WindowNEWsignIn/LogoRecipeBook.png" Grid.Row="2" Grid.RowSpan="2" Grid.Column="15" Grid.ColumnSpan="2"  />

        <StackPanel x:Name="titleStackPanel" Orientation="Horizontal" Grid.Row="2" Grid.RowSpan="2" Grid.Column="8" Grid.ColumnSpan="4" HorizontalAlignment="Center" >

            <Image Source="/RecipeBookPictuers/WindowhomePage/G_AddNewRecipe/IconAddRecipe.png" MaxHeight="30" />
            <StackPanel x:Name="titlesTitleStackPanel"  >
                <TextBlock x:Name="AddNewRecipe" Text="עדכון מתכון"  Foreground="#FF7A4928" FontSize="18" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold"  />
                <TextBlock x:Name="titles" Foreground="#FF7A4928" FontSize="14" TextAlignment="Center" VerticalAlignment="Bottom"  Text="אופן ההכנה" />
            </StackPanel>

        </StackPanel>

        <Image Source="/RecipeBookPictuers/WindowSignIn/MidFrame.png" Margin="3"  Grid.Row="4" Grid.RowSpan="13" Grid.Column="6" Grid.ColumnSpan="8" VerticalAlignment="Bottom"  />
        <TextBlock  x:Name="allDirectionsTextBlock" Grid.Row="5" Grid.RowSpan="1" Grid.Column="8" Grid.ColumnSpan="4" VerticalAlignment="Top" HorizontalAlignment="Center" Text="אופן ההכנה:" Foreground="#FF7A4928" />
       
        <ScrollViewer Grid.Row="6" Grid.RowSpan="10" Grid.Column="8" Grid.ColumnSpan="4" Margin="4">
            <TextBox x:Name="t" Background="{x:Null}" Foreground="#FF7A4928"  TextWrapping="Wrap"  AcceptsReturn="True" />
        </ScrollViewer>
          

        <Button x:Name="continueButton" Content="המשך"   Grid.Row="17" Grid.RowSpan="1" Grid.Column="4" Grid.ColumnSpan="12" Foreground="#FF7A492B" BorderBrush="#FF7A4928" Background="#FFDED5BF" Click="continueButton_Click_1"   />


    </Grid>
</Page>

