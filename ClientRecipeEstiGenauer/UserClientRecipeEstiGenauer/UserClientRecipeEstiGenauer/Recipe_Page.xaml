<Page x:Class="UserClientRecipeEstiGenauer.Recipe_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserClientRecipeEstiGenauer"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Recipe_Page">

    <Page.Background>
        <ImageBrush ImageSource="/RecipeBookPictuers/WindowhomePage/A_Homepage/DarkBackground.png" Opacity="0.1"  />
    </Page.Background>

    <Grid FlowDirection="RightToLeft">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1" Grid.ColumnSpan="8" Grid.Row="1" Grid.RowSpan="5">
            <TextBlock x:Name="recipeNametextblock"       FontSize="48"   TextWrapping="Wrap" Foreground="#FF7A4928" FontFamily="Segoe UI Emoji" />
            <TextBlock x:Name="recipeCommentsTextBlock"   FontSize="24"   TextWrapping="Wrap" Foreground="#FF7A4928"   />
            <TextBlock x:Name="descriptionTextBlock"      FontSize="24"   TextWrapping="Wrap" Foreground="#FF7A4928" />
            <TextBlock x:Name="userNameOfRecipe"          FontSize="15"   TextWrapping="Wrap" Foreground="#FF7A4928" />
        </StackPanel>

        <StackPanel x:Name="ratingStarsStackPanel" Grid.Column="10" Grid.ColumnSpan="5" Grid.Row="1" Grid.RowSpan="1" Orientation="Horizontal" FlowDirection="LeftToRight" >
            <Image x:Name="ratingStars1"  />
            <Image x:Name="ratingStars2"  />
            <Image x:Name="ratingStars3"  />
            <Image x:Name="ratingStars4"  />
            <Image x:Name="ratingStars5"  />
        </StackPanel>

        <Image x:Name="difficultyImage" Source="/RecipeBookPictuers/WindowhomePage/G_AddNewRecipe/difficultIIcon.png" Margin="1" Grid.Column="10" Grid.ColumnSpan="1" Grid.Row="2" Grid.RowSpan="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"  />
        <TextBlock x:Name="recipeDifficulty" Grid.Column="11" Grid.ColumnSpan="3" Grid.Row="2" Grid.RowSpan="1" TextAlignment="Right"   HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" Foreground="#FF8F4B28"/>
        <Image x:Name="servingsImage" Source="/RecipeBookPictuers/WindowhomePage/G_AddNewRecipe/servingIcon.png"  Margin="1" Grid.Column="10" Grid.ColumnSpan="1" Grid.Row="3" Grid.RowSpan="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
        <TextBlock x:Name="recipeservings" Grid.Column="11" Grid.ColumnSpan="3" Grid.Row="3" Grid.RowSpan="1" TextAlignment="Right" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" Foreground="#FF8F4B28"/>
        <Image x:Name="preparationTimeImage"  Source="/RecipeBookPictuers/WindowhomePage/G_AddNewRecipe/PreparationTimeIcon.png"  Margin="1" Grid.Column="10" Grid.ColumnSpan="1" Grid.Row="4" Grid.RowSpan="1" VerticalAlignment="Bottom" HorizontalAlignment="center" Width="100"/>
        <TextBlock x:Name="recipepreparationTime" Grid.Column="11" Grid.ColumnSpan="3" Grid.Row="4" Grid.RowSpan="1" TextAlignment="Right" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="14" Foreground="#FF8F4B28"/>
        <StackPanel  Grid.Column="16" Grid.ColumnSpan="4" Grid.Row="1" Grid.RowSpan="4" HorizontalAlignment="Center">
            <TextBlock x:Name="Notes" Text="הערות"  TextAlignment="Center" Foreground="#FF7A4928" FontSize="14"  />
            <TextBlock x:Name="recipeNotes" TextAlignment="Center"  TextWrapping="Wrap" Foreground="#FF7A4928" FontSize="11" />
        </StackPanel>
        <Image Source="/RecipeBookPictuers/WindowhomePage/Recipe/newpics/newline1.png"  Grid.Column="1" Grid.ColumnSpan="14" Grid.Row="5" Grid.RowSpan="2"  Margin="5" />
        <TextBlock x:Name="ingredientsTextBlock" Text="מרכיבים" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="7" Grid.RowSpan="1" TextAlignment="Center" FontSize="18" Foreground="#FF7A4928" FontFamily="Segoe UI Black"  />
        <ScrollViewer Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="8" Grid.RowSpan="6">
            <TextBlock x:Name="allIngredientsTextBlock"   TextWrapping="Wrap" FontSize="12" Foreground="#FF8F4B28" TextAlignment="Left" />
        </ScrollViewer>
        <Frame x:Name="messagesFrame" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="15" Grid.RowSpan="4"  />
        <Image Source="/RecipeBookPictuers/WindowhomePage/Recipe/newpics/linenewstanding.png"  Grid.Column="6"  Grid.ColumnSpan="2"   Grid.Row="7" Grid.RowSpan="11" />
        <TextBlock x:Name="directionsTextBlock"  Text="אופן ההכנה" Grid.Column="7" Grid.ColumnSpan="7" Grid.Row="7" Grid.RowSpan="1" TextAlignment="Center" FontSize="18" Foreground="#FF7A4928" FontFamily="Segoe UI Black" />
        <ScrollViewer Grid.Column="7" Grid.ColumnSpan="7" Grid.Row="8" Grid.RowSpan="10">
            <TextBlock x:Name="alldirectionsTextBlock"  FontSize="12" Foreground="#FF8F4B28" TextAlignment="Left"  TextWrapping="Wrap" />
        </ScrollViewer>
        <Image x:Name="recipeImage" Grid.Column="16" Grid.ColumnSpan="4" Grid.Row="6" Grid.RowSpan="13"/>
        <Image Source="/RecipeBookPictuers/WindowhomePage/Recipe/newpics/misgeret.png" Grid.Column="15" Grid.ColumnSpan="5" Grid.Row="5"  Grid.RowSpan="15" />
        <Button x:Name="UpdateRecipeButton" Visibility="Hidden"  Content="עדכן מתכון" Margin="2" Grid.Row="0"  Grid.RowSpan="1"  Grid.Column="16" Grid.ColumnSpan="2" BorderBrush="#FFDED5BF" Background="#FFDED5BF" Foreground="#FF7A4928" FontFamily="Franklin Gothic Heavy" Click="UpdateRecipeButton_Click" />
        <Button x:Name="deleteRecipeButton" Visibility="Hidden"  Content="מחק מתכון" Margin="2" Grid.Row="0"  Grid.RowSpan="1"  Grid.Column="18" Grid.ColumnSpan="2" BorderBrush="#FFDED5BF" Background="#FFDED5BF" Foreground="#FF7A4928" FontFamily="Franklin Gothic Heavy" Click="mechakButton_Click" />
   
    </Grid>
</Page>
