<UserControl x:Class="UserClientRecipeEstiGenauer.UserControlAddFolder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UserClientRecipeEstiGenauer"
              xmlns:wpfTool="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Background>
        <ImageBrush ImageSource="/RecipeBookPictuers/WindowhomePage/C_AllRecipes/RecipeFrame.png"/>
    </UserControl.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="1" Grid.Column="1" LostFocus="StackPanel_LostFocus" >
            <wpfTool:WatermarkTextBox x:Name="newFolderName"  TextWrapping="Wrap"  FlowDirection="RightToLeft" Foreground="#FF7C4D2C" FontSize="30" Opacity="0.6" FontFamily="Guttman Yad-Brush"   Watermark="תיקיה חדשה" Background="{x:Null}" LostFocus="newFolderName_LostFocus" PreviewMouseDown="newFolderName_PreviewMouseDown" BorderBrush="White"  />

            <Button x:Name="addImageForNewFulder" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}" Click="addImageForNewFulder_Click" >
                <Image x:Name="newFolderPicture" Source="/RecipeBookPictuers/WindowhomePage/C_AllRecipes/AddPicRecipeFulder.png"  Height="100" />
            </Button>


        </StackPanel>



    </Grid>
</UserControl>
