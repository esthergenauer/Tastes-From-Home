<Window x:Class="RecipesmanagerEsti.Window1SignIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecipesmanagerEsti"
        mc:Ignorable="d"
        Title="Window1SignIn" Height="450" Width="800" WindowState="Maximized">
    
    <Grid FlowDirection="RightToLeft">
        <!-- שכבה תחתונה: צבע רקע לבן -->
        <Border Background="White" Grid.RowSpan="20" Grid.ColumnSpan="20"/>

        <!-- שכבה עליונה: רקע עם תמונה -->
        <Image Source="/pics/DarkBackground.png" Stretch="Fill" Grid.RowSpan="20" Grid.ColumnSpan="20"/>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="0.1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="0.1*" />
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.3*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="0.2*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="0.3*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Image Source="/pics/MidFrame.png" Grid.Column="2"  Grid.ColumnSpan="7" Grid.Row="0" Grid.RowSpan="13" />
        <TextBlock x:Name="recipeBookTextBlock"  Grid.Column="4"  Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="50" FontFamily="Kunstler Script" TextAlignment="Center" Foreground="#FF956F55" FontWeight="Bold"><Run FlowDirection="RightToLeft" Text="טעמים מהבית"/></TextBlock>
        <TextBlock x:Name="recipeBookTextBlock2"  Grid.Column="5"  Grid.ColumnSpan="1" Grid.Row="3"  HorizontalAlignment="Center" VerticalAlignment="Top" Text="מנהל" FontSize="24" Foreground="#FF956F55" />
        <TextBox x:Name="EnterEmailTextBox" Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="3" TextWrapping="Wrap" Text="...הכנס שם"     Background="#FFE0D7C1" BorderBrush="#FF7A4928" Foreground="#FF7A4928" SelectionBrush="#FF7A4928"  PreviewMouseDown="EnterEmailTextBox_PreviewMouseDown" LostFocus="EnterEmailTextBox_LostFocus" TextAlignment="Right"/>
        <TextBox x:Name="EnterPassCodeTextBox"   Grid.Row="8" Grid.Column="4" Grid.ColumnSpan="3"  HorizontalAlignment="Stretch"  TextWrapping="Wrap" Text="...הכנס קוד" VerticalAlignment="Stretch"  Background="#FFDED5BF" BorderBrush="#FF7A4928" Foreground="#FF7A4928"  PreviewMouseDown="EnterPassCodeTextBox_PreviewMouseDown" LostFocus="EnterPassCodeTextBox_LostFocus" TextAlignment="Right"/>
        <Button x:Name="EnterSignInButton" Content="כניסת מנהל"   Grid.Row="10" Grid.RowSpan="2" Grid.Column="4"  Grid.ColumnSpan="3"   VerticalAlignment="Top"  Background="#FFDED5BF" BorderBrush="#FF7A4928" Foreground="#FF7A4928" FontWeight="Bold" Click="EnterButton_Click"/>

       </Grid>
       </Grid>
</Window>
